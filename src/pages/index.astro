---
import '../index.css'
import Logo from '../components/Logo.jsx'
import Wordmark from '../components/Wordmark.jsx'
import DemoSection from '../components/DemoSection.jsx'
import ContactSection from '../components/ContactSection.jsx'
import {
  ClipboardCheck,
  Award,
  Users,
  BarChart2,
  Smartphone,
  GraduationCap,
} from 'lucide-react'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Certivue | Sterile Processing Competency &amp; Compliance Software</title>
    <meta name="description" content="Certivue helps hospital sterile processing departments track competencies, certifications, training records, and TJC audit readiness — all in one platform built for SPD teams." />
    <meta property="og:title" content="Certivue | Sterile Processing Competency &amp; Compliance Software" />
    <meta property="og:description" content="Competency assessments, certification tracking, and compliance documentation built for hospital SPD departments." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://certivue.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://certivue.com" />
  </head>
  <body>
    <div style="background:#0f1117; min-height:100vh; font-family:system-ui, 'Segoe UI', Roboto, sans-serif;">

      <!-- NAV -->
      <nav style="position:fixed; top:0; left:0; right:0; z-index:100; background:#0f1117; border-bottom:0.5px solid rgba(255,255,255,0.08); display:flex; align-items:center; justify-content:space-between; padding:0 40px; height:60px;">
        <a href="#" style="display:flex; align-items:center; gap:10px; text-decoration:none;">
          <Logo size={32} />
          <Wordmark />
        </a>

        <div class="nav-links" style="display:flex; gap:28px;">
          <a href="#features" style="color:rgba(255,255,255,0.6); text-decoration:none; font-size:14px; font-weight:400;">Features</a>
          <a href="#about" style="color:rgba(255,255,255,0.6); text-decoration:none; font-size:14px; font-weight:400;">About</a>
          <a href="#contact" style="color:rgba(255,255,255,0.6); text-decoration:none; font-size:14px; font-weight:400;">Contact</a>
        </div>

        <div style="display:flex; gap:8px; align-items:center;">
          <a
            href="https://app.certivue.com"
            style="background:transparent; color:#22d3c8; font-weight:500; border-radius:8px; padding:8px 18px; text-decoration:none; font-size:14px; white-space:nowrap; border:1px solid #22d3c8;"
          >
            Sign in
          </a>
          <a
            href="#demo"
            style="background:#22d3c8; color:#0f1117; font-weight:500; border-radius:8px; padding:8px 18px; text-decoration:none; font-size:14px; white-space:nowrap;"
          >
            Request a demo
          </a>
        </div>
      </nav>

      <!-- HERO -->
      <section id="features" style="padding-top:140px; padding-bottom:64px; padding-left:20px; padding-right:20px; text-align:center;">
        <div style="max-width:680px; margin:0 auto;">
          <span style="display:inline-block; background:rgba(34,211,200,0.1); border:0.5px solid rgba(34,211,200,0.3); color:#22d3c8; border-radius:999px; font-size:13px; padding:5px 14px; margin-bottom:24px;">
            Built for sterile processing departments
          </span>

          <h1 style="color:#fff; font-size:clamp(32px, 6vw, 48px); font-weight:500; letter-spacing:-1px; line-height:1.15; margin:0 0 20px;">
            Staff competency,<br />
            <span style="color:#22d3c8;">simplified.</span>
          </h1>

          <p style="color:rgba(255,255,255,0.5); font-size:17px; line-height:1.6; margin-bottom:32px;">
            Certivue helps SPD leaders track employee competencies, certifications, and training — all in one place, from any device.
          </p>

          <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
            <a
              href="#demo"
              style="background:#22d3c8; color:#0f1117; font-weight:500; border-radius:8px; padding:10px 22px; text-decoration:none; font-size:15px;"
            >
              Request a demo
            </a>
            <a
              href="#contact"
              style="background:transparent; border:0.5px solid rgba(255,255,255,0.2); color:#fff; border-radius:8px; padding:10px 22px; text-decoration:none; font-size:15px;"
            >
              Contact us
            </a>
          </div>
        </div>
      </section>

      <!-- STATS STRIP -->
      <div style="display:grid; grid-template-columns:repeat(3, 1fr); border-top:0.5px solid rgba(255,255,255,0.06); border-bottom:0.5px solid rgba(255,255,255,0.06); margin:0 40px 64px;">
        <div style="padding:28px 24px; text-align:center;">
          <div style="color:#22d3c8; font-size:28px; font-weight:600; margin-bottom:6px;">100%</div>
          <div style="color:rgba(255,255,255,0.4); font-size:13px;">Paperless compliance</div>
        </div>
        <div style="padding:28px 24px; text-align:center; border-left:1px solid rgba(255,255,255,0.06);">
          <div style="color:#22d3c8; font-size:28px; font-weight:600; margin-bottom:6px;">QR</div>
          <div style="color:rgba(255,255,255,0.4); font-size:13px;">Mobile point-of-care assessments</div>
        </div>
        <div style="padding:28px 24px; text-align:center; border-left:1px solid rgba(255,255,255,0.06);">
          <div style="color:#22d3c8; font-size:28px; font-weight:600; margin-bottom:6px;">A+</div>
          <div style="color:rgba(255,255,255,0.4); font-size:13px;">Automated competency grading</div>
        </div>
      </div>

      <!-- FEATURES -->
      <section id="about" style="padding:0 40px 80px;">
        <div style="margin-bottom:36px;">
          <p style="color:#22d3c8; font-size:11px; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:12px;">
            PLATFORM
          </p>
          <h2 style="color:#fff; font-size:26px; font-weight:500; margin:0; letter-spacing:-0.3px;">
            Everything your SPD team needs to stay compliant
          </h2>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:16px;">
          <div style="background:#161820; border:0.5px solid rgba(255,255,255,0.07); border-radius:12px; padding:24px;">
            <div style="width:36px; height:36px; background:rgba(34,211,200,0.1); border-radius:8px; color:#22d3c8; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
              <ClipboardCheck size={20} />
            </div>
            <h3 style="color:#fff; font-size:15px; font-weight:500; margin:0 0 8px;">Competency tracking</h3>
            <p style="color:rgba(255,255,255,0.45); font-size:14px; line-height:1.55; margin:0;">Build assessment templates, assign by clinical role, and grade via QR code on the floor.</p>
          </div>
          <div style="background:#161820; border:0.5px solid rgba(255,255,255,0.07); border-radius:12px; padding:24px;">
            <div style="width:36px; height:36px; background:rgba(34,211,200,0.1); border-radius:8px; color:#22d3c8; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
              <Award size={20} />
            </div>
            <h3 style="color:#fff; font-size:15px; font-weight:500; margin:0 0 8px;">Certification management</h3>
            <p style="color:rgba(255,255,255,0.45); font-size:14px; line-height:1.55; margin:0;">Track CRCST, CBSPD, and custom certs with expiration alerts and document uploads.</p>
          </div>
          <div style="background:#161820; border:0.5px solid rgba(255,255,255,0.07); border-radius:12px; padding:24px;">
            <div style="width:36px; height:36px; background:rgba(34,211,200,0.1); border-radius:8px; color:#22d3c8; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
              <Users size={20} />
            </div>
            <h3 style="color:#fff; font-size:15px; font-weight:500; margin:0 0 8px;">Staff profiles</h3>
            <p style="color:rgba(255,255,255,0.45); font-size:14px; line-height:1.55; margin:0;">Manage your full roster with department assignments, roles, and training history.</p>
          </div>
          <div style="background:#161820; border:0.5px solid rgba(255,255,255,0.07); border-radius:12px; padding:24px;">
            <div style="width:36px; height:36px; background:rgba(34,211,200,0.1); border-radius:8px; color:#22d3c8; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
              <BarChart2 size={20} />
            </div>
            <h3 style="color:#fff; font-size:15px; font-weight:500; margin:0 0 8px;">Dashboard analytics</h3>
            <p style="color:rgba(255,255,255,0.45); font-size:14px; line-height:1.55; margin:0;">See competency gaps, staff requiring attention, and compliance at a glance.</p>
          </div>
          <div style="background:#161820; border:0.5px solid rgba(255,255,255,0.07); border-radius:12px; padding:24px;">
            <div style="width:36px; height:36px; background:rgba(34,211,200,0.1); border-radius:8px; color:#22d3c8; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
              <Smartphone size={20} />
            </div>
            <h3 style="color:#fff; font-size:15px; font-weight:500; margin:0 0 8px;">Mobile assessments</h3>
            <p style="color:rgba(255,255,255,0.45); font-size:14px; line-height:1.55; margin:0;">Scan a QR code at the point of care. No login required for technicians being assessed.</p>
          </div>
          <div style="background:#161820; border:0.5px solid rgba(255,255,255,0.07); border-radius:12px; padding:24px;">
            <div style="width:36px; height:36px; background:rgba(34,211,200,0.1); border-radius:8px; color:#22d3c8; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
              <GraduationCap size={20} />
            </div>
            <h3 style="color:#fff; font-size:15px; font-weight:500; margin:0 0 8px;">CertiGym</h3>
            <p style="color:rgba(255,255,255,0.45); font-size:14px; line-height:1.55; margin:0;">Prep for CRCST, CBSPD, and other exams with practice questions curated by SPD experts.</p>
          </div>
        </div>
      </section>

      <!-- DEMO -->
      <DemoSection client:load />

      <!-- CONTACT -->
      <ContactSection client:load />

      <!-- FOOTER -->
      <footer style="border-top:0.5px solid rgba(255,255,255,0.06); padding:40px; display:flex; flex-direction:column; gap:24px;">
        <div>
          <p style="color:#22d3c8; font-size:11px; letter-spacing:1.5px; text-transform:uppercase; margin:0 0 12px;">Solutions</p>
          <div style="display:flex; flex-direction:column; gap:8px;">
            <a href="/competency-tracking" style="color:rgba(255,255,255,0.6); text-decoration:none; font-size:14px; font-weight:400;">Competency Tracking</a>
            <a href="/certification-tracking" style="color:rgba(255,255,255,0.6); text-decoration:none; font-size:14px; font-weight:400;">Certification Tracking</a>
            <a href="/training-records" style="color:rgba(255,255,255,0.6); text-decoration:none; font-size:14px; font-weight:400;">Training & In-Service Records</a>
            <a href="/compliance" style="color:rgba(255,255,255,0.6); text-decoration:none; font-size:14px; font-weight:400;">Compliance & Survey Readiness</a>
            <a href="/" style="color:rgba(255,255,255,0.6); text-decoration:none; font-size:14px; font-weight:400;">Home</a>
          </div>
        </div>
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
          <a href="#" style="display:flex; align-items:center; gap:8px; text-decoration:none;">
            <Logo size={24} />
            <Wordmark />
          </a>
          <span style="color:rgba(255,255,255,0.25); font-size:12px;">
            © 2026 Certivue. Built for sterile processing.
          </span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  @media (max-width: 640px) {
    .nav-links {
      display: none !important;
    }
  }
</style>
